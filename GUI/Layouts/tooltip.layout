FrameWidgetClass TooltipPanel {
 ignorepointer 1
 position 0 0
 size 1 1
 halign left_ref
 valign top_ref
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 priority 999
 {
  PanelWidgetClass TooltipBackground {
   ignorepointer 1
   color 0.1 0.1 0.1 0.95
   position 0 0
   size 400 300
   halign left_ref
   valign top_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
   {
    TextWidgetClass TooltipTitle {
     ignorepointer 1
     position 10 10
     size 380 30
     halign left_ref
     valign top_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text "Item Name"
     font "gui/fonts/metron_bold26"
     "text halign" left
     "text valign" center
    }
    ScrollWidgetClass TooltipScroll {
     ignorepointer 0
     position 10 50
     size 380 200
     halign left_ref
     valign top_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style blank
     vscrollbar 1
     {
      TextWidgetClass TooltipDescription {
       ignorepointer 1
       position 0 0
       size 380 200
       halign left_ref
       valign top_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 0
       text "Description text here"
       font "gui/fonts/metron18"
       "text halign" left
       "text valign" top
       "exact text" 0
       "size to text h" 0
       "size to text v" 1
       "text wrap" 1
       wrap 1
      }
     }
    }
    TextWidgetClass TooltipPrice {
     ignorepointer 1
     position 10 260
     size 380 30
     halign left_ref
     valign top_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text "Price: 1000 ZCoins"
     font "gui/fonts/metron20"
     "text halign" left
     "text valign" center
     "text color" 1 0.8 0 1
    }
   }
  }
 }
}
